# =================================================
# Jarvis 2.0 - .gitignore
# =================================================

# --- Virtual Environments ---
venv/
.venv/

# --- Sensitive Configuration (CRITICAL: Never Commit) ---
config.py

# --- Runtime Databases & Memory ---
jarvis.db
jarvis_memory_db/
chroma_db/
brain_db/

# --- Python Compiled Files ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Large Binary Model Files ---
engine/*.onnx
engine/*.bin
engine/*.jit

# --- Log & Temp Files ---
*.log
debug_log.txt
brain_error_log.txt
Debug_log.txt
*.mp3
.cache

# --- OS / Editor Artifacts ---
*.DS_Store
.cursorignore

# --- Node.js (JarvisUI) ---
JarvisUI/node_modules/

# --- User-Specific Profile ---
user_profile.json